# Produktions-Umgebungsvariablen
# Kopieren nach .env.prod und anpassen

# Domain (für Caddy / Let's Encrypt)
DOMAIN=netasset.example.com

# GitHub-Repo für Container-Image (user/repo)
GITHUB_REPO=myuser/netasset
IMAGE_TAG=latest

# Docker-Compose (scripts/docker_start.sh): standardmäßig lokaler Build als
# netasset-api:latest. Für ein vorgebautes Registry-Image hier setzen, z.B.:
# API_IMAGE=ghcr.io/myuser/netasset:latest

# Datenbank-Passwort – starkes Passwort wählen!
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# Modell – beliebig wählbar (anthropic/claude-sonnet-4-5, openai/gpt-4o, ...)
LLM_MODEL=anthropic/claude-sonnet-4-5

# Auth – BEIDE Werte sind Pflicht, die API startet sonst nicht.
# Secret erzeugen:  openssl rand -base64 48
# (mindestens 32 Zeichen; ein Wechsel invalidiert alle bestehenden Logins)
JWT_SECRET=
INITIAL_ADMIN_PASSWORD=

# CORS: nur nötig, wenn ein anderer Dienst die API im Browser aufruft.
# Frontend und API laufen hinter Caddy auf derselben Origin – dann leer lassen.
# Beispiel: CORS_ORIGINS=https://bl.example.com
CORS_ORIGINS=

# Domain des Betriebsleitfadens (zweiter Site-Block im Caddyfile)
BL_DOMAIN=bl.example.com

# NVD API Key (optional, erhöht Rate-Limit)
NVD_API_KEY=

# Embedding-Modell
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Log-Level
LOG_LEVEL=INFO
